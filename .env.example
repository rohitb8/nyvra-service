# Copy to .env and adjust. .env is git-ignored. See docs/operations/ENVIRONMENTS.md section 6.
# For local dev the application-local.yml defaults already match the docker-compose stack,
# so you usually only need this file when overriding something.

SPRING_PROFILES_ACTIVE=local

# --- Database (Postgres + TimescaleDB) ---
NYVRA_DB_URL=jdbc:postgresql://localhost:5432/nyvra
NYVRA_DB_USERNAME=nyvra
NYVRA_DB_PASSWORD=nyvra
NYVRA_DB_POOL_MAX=5

# --- Redis ---
NYVRA_REDIS_URL=redis://localhost:6379

# --- RabbitMQ ---
NYVRA_RABBITMQ_URL=amqp://guest:guest@localhost:5672

# --- Object storage (MinIO locally) ---
NYVRA_S3_ENDPOINT=http://localhost:9000
NYVRA_S3_BUCKET=nyvra-documents
NYVRA_S3_ACCESS_KEY=nyvra
NYVRA_S3_SECRET_KEY=nyvra-secret

# --- Auth (Keycloak) ---
NYVRA_OIDC_ISSUER_URI=http://localhost:8081/realms/nyvra
NYVRA_OIDC_AUDIENCE=nyvra-api
NYVRA_CORS_ALLOWED_ORIGINS=http://localhost:4200

# --- Field-level encryption key (32 bytes, base64). Generate a real one; keep it out of git. ---
NYVRA_FIELD_ENCRYPTION_KEY=CHANGE_ME_base64_32_bytes

# --- External integrations (sandbox creds for non-prod) ---
NYVRA_AA_BASE_URL=
NYVRA_AA_CLIENT_ID=
NYVRA_AA_CLIENT_SECRET=
NYVRA_PRICE_FEED_API_KEY=
